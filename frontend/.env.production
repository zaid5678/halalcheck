# Public build settings for the deployed site (committed on purpose: nothing here is secret).
# The backend URL lives here rather than in the hosting dashboard, so every build from GitHub
# points at the right server. A VITE_HALALCHECK_API_URL set in the dashboard would override it.
# Never put API keys here: everything in VITE_ variables is visible in the browser.
VITE_HALALCHECK_API_URL=https://halalcheck-api-o4v5.onrender.com
