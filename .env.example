# Copy to backend/.env (backend settings) and/or frontend/.env (frontend settings).
# All values are optional; the defaults below are what the app uses when unset.

# ---------------------------------------------------------------- Backend (backend/.env)
# Comma-separated browser origins allowed to call the API.
HALALCHECK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HALALCHECK_LOG_LEVEL=INFO

# Open Food Facts asks every client to identify itself as AppName/Version (ContactEmail).
# Replace the email with a real contact address before deploying.
HALALCHECK_OFF_USER_AGENT=HalalCheck/0.1 (contact@example.com)
HALALCHECK_OFF_BASE_URL=https://world.openfoodfacts.org
HALALCHECK_OFF_SEARCH_URL=https://search.openfoodfacts.org/search
HALALCHECK_OFF_LEGACY_SEARCH_URL=https://world.openfoodfacts.org/cgi/search.pl
HALALCHECK_OFF_CONNECT_TIMEOUT=5
HALALCHECK_OFF_READ_TIMEOUT=10
HALALCHECK_SEARCH_PAGE_SIZE=24

# Halal checks: LLM via OpenRouter. Without a key, barcode checks use the ingredient rules only
# and photo checks are unavailable.
HALALCHECK_OPENROUTER_API_KEY=
HALALCHECK_LLM_MODEL=openai/gpt-6.1-terra
HALALCHECK_LLM_TIMEOUT=30
HALALCHECK_MAX_IMAGE_BYTES=5242880

# ---------------------------------------------------------------- Frontend (frontend/.env)
# Where the Vite dev server proxies /api requests.
API_PROXY_TARGET=http://localhost:8000
# Serve the dev server over HTTPS on your local network, so a phone can use the camera.
DEV_HTTPS=false
# Absolute API URL for deployed builds when the API is on a different origin.
# Leave empty to call /api on the same origin.
VITE_API_BASE_URL=
