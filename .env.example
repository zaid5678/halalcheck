# Copy to backend/.env (backend settings) and/or frontend/.env (frontend settings).
# All values are optional; the defaults below are what the app uses when unset.

# ---------------------------------------------------------------- Backend (backend/.env)
# Comma-separated browser origins allowed to call the API (add your Vercel URL in production).
HALALCHECK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HALALCHECK_LOG_LEVEL=INFO

# AI ingredient analysis (OpenRouter). Get a key at https://openrouter.ai/keys.
# Keep the real key in .env only (git-ignored); never in frontend/VITE_ variables.
OPENROUTER_API_KEY=
# Any OpenRouter model that accepts image input and supports structured outputs.
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Set to false for models without structured-output support (schema goes in the prompt instead).
HALALCHECK_OPENROUTER_STRUCTURED_OUTPUTS=true
HALALCHECK_OPENROUTER_TIMEOUT_SECONDS=90
# Paid analyses allowed per client IP per hour (0 disables the limit).
HALALCHECK_ANALYSIS_RATE_LIMIT_PER_HOUR=30

# Image uploads
HALALCHECK_MAX_UPLOAD_BYTES=10485760
HALALCHECK_MAX_IMAGE_PIXELS=40000000

# ---------------------------------------------------------------- Frontend (frontend/.env)
# Where the Vite dev server proxies /api requests.
API_PROXY_TARGET=http://localhost:8000
# Serve the dev server over HTTPS on your local network, so a phone can use the camera.
DEV_HTTPS=false
# Absolute API URL for deployed builds, e.g. https://halalcheck-api.onrender.com
# Leave empty to call /api on the same origin.
VITE_API_BASE_URL=
