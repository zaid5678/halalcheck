# Copy to backend/.env (backend settings) and/or frontend/.env (frontend settings).
# All values are optional; the defaults below are what the app uses when unset.

# ---------------------------------------------------------------- Backend (backend/.env)
# Comma-separated browser origins allowed to call the API (add your Netlify URL in production).
HALALCHECK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HALALCHECK_LOG_LEVEL=INFO

# Ingredients OCR
# Full path to the tesseract binary if it isn't on PATH (e.g. on Windows:
# C:\Program Files\Tesseract-OCR\tesseract.exe).
HALALCHECK_TESSERACT_CMD=
# Tesseract languages joined with "+", e.g. eng+fra. Each needs its language pack installed.
HALALCHECK_OCR_LANGUAGES=eng
HALALCHECK_OCR_MAX_UPLOAD_BYTES=10485760
HALALCHECK_OCR_MAX_IMAGE_PIXELS=40000000
HALALCHECK_OCR_TIMEOUT_SECONDS=45
HALALCHECK_OCR_MAX_CONCURRENCY=2

# ---------------------------------------------------------------- Frontend (frontend/.env)
# Where the Vite dev server proxies /api requests.
API_PROXY_TARGET=http://localhost:8000
# Serve the dev server over HTTPS on your local network, so a phone can use the camera.
DEV_HTTPS=false
# Absolute API URL for deployed builds, e.g. https://halalcheck-api.onrender.com
# Leave empty to call /api on the same origin.
VITE_API_BASE_URL=
